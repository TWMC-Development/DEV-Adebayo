<!-- Blog -->
<style>
@media only screen and (max-width: 1200px) {
    .twmcblog__flex-container-4col {
        flex-direction: row;
        gap: 0;
    }

    .twmcblog__flex-item-4col {
        flex-basis: 100%;
    }
}
</style>

<section class="py-6 stw26-bg-bluegrad">
    <div class="container-fluid mx-sm-5">
      <div class="twmcblog__flex-container-4col">
        <!-- cards -->
        <div class="twmcblog__flex-item-4col">
            <div class="twmc-home-blog__info-title">
                <img class="img-responsive mb-2" src="https://rockrms-assets.s3.us-east-2.amazonaws.com/images/_stewardship2026/HiImMark_Circle360-seasonal2.png">
                <h2 class="twmc-h2 text-white">Senior Pastor Blog</h2>
            </div>
            <div class="twmc-home-blog__info-text text-white">
                <p class="twmc-p">Read our most recent blogs and find message summaries, up-to-date information on the latest events around the church and reflections on personal faith journeys from our TWMC staff.</p>
            </div>
            <div class="twmc-home-blog__info-button">
                <a href="/blog" class="btn stw26-btn-primary text-uppercase" target="_blank" referrerpolicy="origin">Find more</a>
            </div>
        </div>

        {% assign itemCount = Items | Size %}
        {% assign campusCount = itemCount | Times:4 %}

        {% if itemCount > 0 %}{% for item in Items %}

        {% assign image = item | Attribute:'Image','object' %}
        {% assign author = item | Attribute:'Author','object' %}

        <div class="twmcblog__flex-item-4col twmc-card" style="background-color: #fff;">
            <a href="/blog/{{item.PrimarySlug}}">
              <!-- card img -->
              <img src="/GetImage.ashx?id={{ image.Id }}&Width=600" alt="" class="twmc-card--img twmcblog__card-img">

              <!-- card body -->
              <div class="twmc-card-body">
                <h3 class="twmcblog__card-title">{{ item.Title }}</h3>
                <p class="twmcblog__card-text">{{ item | Attribute:'Excerpt' | StripHtml | Truncate:360,'...' }}</p>

                <!-- card info -->
                <div class="twmcblog__card-info-wrapper">
                  <img src="/GetImage.ashx?id={{ author.PhotoId }}&Width=200" alt="" class="twmcblog__card-info-img">
                  <div class="twmcblog__card-info">
                    <p class="twmcblog__card-info-text"><strong>{{ author.TitleValue.Value }} {{ author.FullName }}</strong></p>
                    <p class="twmcblog__card-info-text">{{ item.StartDateTime | Date:'MMMM d, yyyy'   }}</p>
                    <p class="twmcblog__card-info-text">{{ item.Content | ReadTime }}</p>
                  </div>
                </div>
              </div>
            </a>

          </div>

        {% endfor %}{% else %}<h3>There are no blog posts.</h3>{% endif %}


      </div>

    </div>
</section>
<!-- End of Blog -->

