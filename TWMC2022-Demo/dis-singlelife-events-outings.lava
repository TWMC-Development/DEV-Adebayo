<style>
.singlelife-tag-allsingle {
  display: inline-block;
  color: #333;
  font-size: .53rem;
  font-weight: 700;
  line-height: 1.5;
  text-align: center !important;
  text-decoration: none;
  text-transform: uppercase;
  vertical-align: middle;
  background-color: #F3E4DD;
  border: 1px solid #F3E4DD;
  border-radius: .25rem;
  padding: .3rem .45rem .2rem;
  letter-spacing: 2px;
  cursor: not-allowed;
}

.singlelife-tag-widows {
  display: inline-block;
  color: #333;
  font-size: .53rem;
  font-weight: 700;
  line-height: 1.5;
  text-align: center !important;
  text-decoration: none;
  text-transform: uppercase;
  vertical-align: middle;
  background-color: #bdb3d6;
  border: 1px solid #bdb3d6;
  border-radius: .25rem;
  padding: .3rem .45rem .2rem;
  letter-spacing: 2px;
  cursor: not-allowed;
}

.singlelife-tag-singlemom {
  display: inline-block;
  color: #333;
  font-size: .53rem;
  font-weight: 700;
  line-height: 1.5;
  text-align: center !important;
  text-decoration: none;
  text-transform: uppercase;
  vertical-align: middle;
  background-color: #B9D4AA;
  border: 1px solid #B9D4AA;
  border-radius: .25rem;
  padding: .3rem .45rem .2rem;
  letter-spacing: 2px;
  cursor: not-allowed;
}

/* Tags | Buttons */
.twmc--btn--tag-grey3 {
    display: inline-block;
    color: #fff;
    font-size: .53rem;
    font-weight: 700;
    line-height: 1.5;
    text-align: center !important;
    text-decoration: none;
    text-transform: uppercase;
    vertical-align: middle;
    background-color: #656463;
    border: 1px solid #656463;
    border-radius: .25rem;
    padding: .3rem .45rem .2rem;
    letter-spacing: 2px;
    cursor: not-allowed;
}

</style>

<section class="py-6">
  <div class="container-fluid">
    <div class="row">
      <div class="col-sm-10 col-sm-offset-1 col-md-8 col-md-offset-2">

        <div class="text-center twmc-mbm">
          <h3 class="twmc-h3 text-uppercase">Single Life Outings</h3>
        </div>

        <div class="flex-container-2col">
          {% assign today = 'Now' | Date | AsDateTime %}
          {% assign hasItems = false %}

          {% for item in Items %}
            {% assign rawEventDate = item | Attribute:'EventDate' %}
            {% assign locationType = item | Attribute:'EventLocationType' %}
            {% assign timeInfo = item | Attribute:'TimeInfo' %}
            {% assign location = item | Attribute:'Location' %}
            {% assign address = item | Attribute:'Address' %}
            {% assign mapLink = item | Attribute:'MapLink' %}
            {% assign childcare = item | Attribute:'ChildcareNote' %}
            {% assign price = item | Attribute:'PriceNote' %}
            {% assign btnText = item | Attribute:'ButtonText' %}
            {% assign regLink = item | Attribute:'RegistrationLink' %}

            {% if rawEventDate != '' %}
              {% assign eventDate = rawEventDate | AsDateTime %}

              {% if eventDate >= today %}
                {% if locationType == 'Local' or locationType == 'Out of Town' %}
                  {% assign hasItems = true %}

                  <div class="flex-item-2col twmc-card-float mb-3">
                    <h4 class="twmc-h4 text-uppercase text-traditional mb-2">
                      <strong>{{ item.Title }}</strong>
                    </h4>

                    {% assign singlesCats = item | Attribute:'SinglesCategory' | Split:',' %}
                    {% for cat in singlesCats %}
                      {% assign catTrim = cat | Trim %}
                      {% if catTrim == 'All Singles' %}
                        <p class="singlelife-tag-allsingle mb-0">All Singles</p>
                      {% elsif catTrim == 'Widows' %}
                        <p class="singlelife-tag-widows mb-0">Widows</p>
                      {% elsif catTrim == 'Single Moms' %}
                        <p class="singlelife-tag-singlemom mb-0">Single Moms</p>
                      {% endif %}
                    {% endfor %}

                    {% if locationType == 'Local' %}
                    <p class="twmc--btn--tag-grey3 mb-0">{{ locationType }}</p>
                    {% else %}
                    <p class="twmc--btn--tag-grey2 mb-0">{{ locationType }}</p>
                    {% endif %}

                    <p class="twmc-p my-3 twmc-text-09">
                      <strong>
                        <span class="twmc-icon-wrapper2"><i class="fas fa-calendar-alt"></i></span>
                        {{ eventDate | Date:'dddd, MMMM d, yyyy' }}
                        <br>

                        {% if timeInfo != '' %}
                          <span class="twmc-icon-wrapper2"><i class="fas fa-clock"></i></span>
                          {{ timeInfo }}
                          <br>
                        {% endif %}

                        {% if location != '' %}
                          <span class="twmc-icon-wrapper2"><i class="fas fa-landmark"></i></span>
                          {{ location }}
                          <br>
                        {% endif %}

                        {% if address != '' %}
                          <span class="twmc-icon-wrapper2"><i class="fa-solid fa-map-location-dot"></i></span>
                          {% if mapLink != '' %}
                            <a href="{{ mapLink }}" class="a-traditional" target="_blank">{{ address }} &rarr;</a>
                          {% else %}
                            {{ address }}
                          {% endif %}
                          <br>
                        {% endif %}

                        {% if childcare != '' %}
                          <span class="twmc-icon-wrapper2"><i class="fa-solid fa-children"></i></span>
                          {{ childcare }}
                          <br>
                        {% endif %}

                        {% if price != '' %}
                          <span class="twmc-icon-wrapper2"><i class="fas fa-money-bill"></i></span>
                          {{ price }}
                        {% endif %}
                      </strong>
                    </p>

                    {% if item.Content != '' %}
                      <div>
                        <p class="twmc-p">{{ item.Content }}</p>
                      </div>
                    {% endif %}

                    {% if regLink != '' %}
                      <a href="{{ regLink }}" class="twmc--btn twmc--btn--small twmc--btn--traditional twmc-letspac-2 my-2" target="_blank">
                        {% if btnText != '' %}{{ btnText }}{% else %}Register{% endif %}
                      </a>
                    {% endif %}
                  </div>
                {% endif %}
              {% endif %}
            {% endif %}
          {% endfor %}

          {% unless hasItems %}
            <div class="col-sm-12 text-center">
              <p class="twmc-p">No upcoming outings at this time.</p>
            </div>
          {% endunless %}
        </div>

      </div>
    </div>
  </div>
</section>
