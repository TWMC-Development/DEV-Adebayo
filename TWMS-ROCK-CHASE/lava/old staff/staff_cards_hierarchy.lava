<!-- Content -->
<section class="twms__section-pymed twms__content">
    <div class="container">
      <div class="row mt-4">
        <div class="col-sm-12">

          {% sql return:'sorted_members' %}
            SELECT
                [PersonId] = p.Id
            FROM GroupMember gm
            JOIN Person p ON p.Id = gm.PersonId
            LEFT JOIN AttributeValue av ON av.EntityId = p.Id AND av.AttributeId = 62756
            WHERE gm.GroupId = 221599
            ORDER BY ISNULL(av.ValueAsNumeric, 999999999), p.LastName
        {% endsql %}



          {% assign faculty_members = '' %}
          {% assign admin_members = '' %}
          {% assign leadership_members = '' %}

          {% for member in sorted_members %}
          {% assign personObj = member.PersonId | PersonById %}
          {% assign sgroup = personObj | Attribute:'StaffGroup' %}
          {% assign hierarchy = personObj | Attribute:'Hierarchy' %}

          {% if sgroup == 'Faculty' %}
          {% capture faculty_members %}
          {{ faculty_members }}
          <div class="twms-staff__flex-item-4col twms-staff__card">

            {% assign profphoto = personObj | Attribute:'WebsiteImage','Url' %}
            {% if profphoto and profphoto != '' %}
            <img src="{{ profphoto }}" alt="" class="twms-staff__img mb-3"></a>
            {% else %}
            <img src="https://people.thewoodlandsmethodist.org/Assets/Images/person-no-photo-unknown.svg" alt""
              class="twms-staff__img mb-3"></a>
            {% endif %}

            <a href="" class="twms-staff__card-name" data-toggle="modal" data-target="#facultyModal{{ forloop.index }}">
              {% if personObj | Property:'NickName' != '' %}
              {{ personObj | Property:'NickName' }}
              {% else %}
              {{ personObj | Property:'FirstName' }}
              {% endif %}
              {{ personObj | Property:'LastName' }}
            </a>
            <p>
              Faculty
              <br><em>{{ personObj | Attribute:'Position' }}</em>
              <br><a href="mailto:{{ personObj | Attribute: 'StaffWebsiteEmail'}}">
                {{ personObj | Attribute: 'StaffWebsiteEmail' }}
              </a>
            </p>
            <div class="twms-staff-modal modal fade" id="facultyModal{{ forloop.index }}" tabindex="-1" role="dialog"
              aria-labelledby="facultyModalLabel{{ forloop.index }}">
              <div class="modal-dialog" role="document">
                <div class="modal-content">
                  <div class="modal-header">
                    <h4 class="modal-title" id="facultyModalLabel{{ forloop.index }}">
                      {% if personObj | Property:'NickName' != '' %}
                      {{ personObj | Property:'NickName' }}
                      {% else %}
                      {{ personObj | Property:'FirstName' }}
                      {% endif %}
                      {{ personObj | Property:'LastName' }}

                    </h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true" class="close-right">&times;</span>
                    </button>
                  </div>


                  <div class="modal-body">
                    {% comment %} conditional render for photo in modal body {% endcomment %}
                    {% if profphoto and profphoto != '' %}
                    <img src="{{ profphoto }}" alt="" class="twms-staff__img-small">
                    {% else %}
                    <img src="https://people.thewoodlandsmethodist.org/Assets/Images/person-no-photo-unknown.svg" alt""
                      class="twms-staff__img-small"></a>
                    {% endif %}


                    <h4>{{ personObj | Attribute:'Position' }}</h4>
                    {% assign philosophy = personObj | Attribute:'Philosophy' %}
                    {% if philosophy != '' and philosophy != null %}
                    <strong>Educational Philosophy</strong><br /> {{ philosophy }}<br>
                    {% endif %}
                    {% assign ematrix = personObj | Attribute:'Education','Object' %}
                    {% if ematrix.AttributeMatrixItems != empty %}
                    <p class="mb-0"><strong>Education</strong><br />
                      {% for item in ematrix.AttributeMatrixItems %}
                      {{ item | Attribute:'Education' }}<br>
                      {% endfor %}
                    </p>
                    {% endif %}
                    {% assign about = personObj | Attribute:'About' %}
                    {% if about != '' and about != null %}
                    <strong>About</strong>
                    <p>{{ personObj | Attribute:'About' }}</p>
                    {% endif %}
                  </div>
                  <div class="modal-footer">
                    <div class="ml-auto">
                      <button type="button"
                        class="twms__button twms__button-outline-dark-blue custom-button-width-modal-close"
                        data-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% endcapture %}
          {% elsif sgroup == 'Admin' %}
          {% capture admin_members %}
          {{ admin_members }}
          <div class="twms-staff__flex-item-4col twms-staff__card">
            <a href="" data-toggle="modal" data-target="#adminModal{{ forloop.index }}">

              {% assign profphoto = personObj | Attribute:'WebsiteImage','Url' %}

              {% if profphoto and profphoto != '' %}
              <img src="{{ profphoto }}" alt="" class="twms-staff__img mb-3"></a>
            {% else %}
            <img src="https://people.thewoodlandsmethodist.org/Assets/Images/person-no-photo-unknown.svg" alt""
              class="twms-staff__img mb-3"></a>
            {% endif %}

            <a href="" class="twms-staff__card-name" data-toggle="modal" data-target="#adminModal{{ forloop.index }}">
              {% if personObj | Property:'NickName' != '' %}
              {{ personObj | Property:'NickName' }}
              {% else %}
              {{ personObj | Property:'FirstName' }}
              {% endif %}
              {{ personObj | Property:'LastName' }}
            </a>
            <p>
              Admin
              <br><em>{{ personObj | Attribute:'Position' }}</em>
              <br><a href="mailto:{{ personObj | Attribute: 'StaffWebsiteEmail'}}">
                {{ personObj | Attribute: 'StaffWebsiteEmail' }}</a>
            </p>
            <div class="twms-staff-modal modal fade" id="adminModal{{ forloop.index }}" tabindex="-1" role="dialog"
              aria-labelledby="adminModalLabel{{ forloop.index }}">
              <div class="modal-dialog" role="document">
                <div class="modal-content">
                  <div class="modal-header">
                    <h4 class="modal-title" id="facultyModalLabel{{ forloop.index }}">
                      {% if personObj | Property:'NickName' != '' %}
                      {{ personObj | Property:'NickName' }}
                      {% else %}
                      {{ personObj | Property:'FirstName' }}
                      {% endif %}
                      {{ personObj | Property:'LastName' }}
                    </h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true" class="close-right">&times;</span>
                    </button>
                  </div>
                  <div class="modal-body">

                    <!--<img src="{{ personObj | Attribute:'WebsiteImage','Url' }}" alt="" class="twms-staff__img-small">-->

                    {% if profphoto and profphoto != '' %}
                    <img src="{{ profphoto }}" alt="" class="twms-staff__img-small">
                    {% else %}
                    <img src="https://people.thewoodlandsmethodist.org/Assets/Images/person-no-photo-unknown.svg" alt""
                      class="twms-staff__img-small"></a>
                    {% endif %}

                    <h4>{{ personObj | Attribute:'Position' }}</h4>
                    {% assign philosophy = personObj | Attribute:'Philosophy' %}
                    {% if philosophy != '' and philosophy != null %}
                    <strong>Educational Philosophy</strong><br /> {{ philosophy }}<br>
                    {% endif %}
                    {% assign ematrix = personObj | Attribute:'Education','Object' %}
                    {% if ematrix.AttributeMatrixItems != empty %}
                    <p class="mb-0"><strong>Education</strong><br />
                      {% for item in ematrix.AttributeMatrixItems %}
                      {{ item | Attribute:'Education' }}<br>
                      {% endfor %}
                    </p>
                    {% endif %}
                    {% assign about = personObj | Attribute:'About' %}
                    {% if about != '' and about != null %}
                    <strong>About</strong>
                    <p>{{ personObj | Attribute:'About' }}</p>
                    {% endif %}
                  </div>
                  <div class="modal-footer">
                    <div class="ml-auto">
                      <button type="button"
                        class="twms__button twms__button-outline-dark-blue custom-button-width-modal-close"
                        data-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% endcapture %}
          {% elsif sgroup == 'Leadership' %}
          {% capture leadership_members %}
          {% assign leaders = leadership_members | OrderBy:'hierarchy' %}
          {{ leadership_members }}
          <div class="twms-staff__flex-item-4col twms-staff__card">
            <a href="" data-toggle="modal" data-target="#leadershipModal{{ forloop.index }}">

              {% assign profphoto = personObj | Attribute:'WebsiteImage','Url' %}
              {% if profphoto and profphoto != '' %}
              <img src="{{ profphoto }}" alt="" class="twms-staff__img mb-3"></a>
            {% else %}
            <img src="https://people.thewoodlandsmethodist.org/Assets/Images/person-no-photo-unknown.svg" alt""
              class="twms-staff__img mb-3"></a>
            {% endif %}

            <a href="" class="twms-staff__card-name" data-toggle="modal"
              data-target="#leadershipModal{{ forloop.index }}">
              {% if personObj | Property:'NickName' != '' %}
              {{ personObj | Property:'NickName' }}
              {% else %}
              {{ personObj | Property:'FirstName' }}
              {% endif %}
              {{ personObj | Property:'LastName' }}
            </a>
            <p>
              Leadership
              <br><em>{{ personObj | Attribute:'Position' }}</em>
              <br><a href="mailto:{{ personObj | Attribute: 'StaffWebsiteEmail'}}">
                {{ personObj | Attribute:'StaffWebsiteEmail' }}</a>
            </p>
            <div class="twms-staff-modal modal fade" id="leadershipModal{{ forloop.index }}" tabindex="-1" role="dialog"
              aria-labelledby="leadershipModalLabel{{ forloop.index }}">
              <div class="modal-dialog" role="document">
                <div class="modal-content">
                  <div class="modal-header">
                    <h4 class="modal-title" id="facultyModalLabel{{ forloop.index }}">
                      {% if personObj | Property:'NickName' != '' %}
                      {{ personObj | Property:'NickName' }}
                      {% else %}
                      {{ personObj | Property:'FirstName' }}
                      {% endif %}
                      {{ personObj | Property:'LastName' }}
                    </h4>
                    <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                      <span aria-hidden="true" class="close-right">&times;</span>
                    </button>
                  </div>
                  <div class="modal-body">

                    {% if profphoto and profphoto != '' %}
                    <img src="{{ profphoto }}" alt="" class="twms-staff__img-small">
                    {% else %}
                    <img src="https://people.thewoodlandsmethodist.org/Assets/Images/person-no-photo-unknown.svg" alt""
                      class="twms-staff__img-small"></a>
                    {% endif %}

                    <h4>{{ personObj | Attribute:'Position' }}</h4>
                    {% assign philosophy = personObj | Attribute:'Philosophy' %}
                    {% if philosophy != '' and philosophy != null %}
                    <strong>Educational Philosophy</strong><br /> {{ philosophy }}<br>
                    {% endif %}
                    {% assign ematrix = personObj | Attribute:'Education','Object' %}
                    {% if ematrix.AttributeMatrixItems != empty %}
                    <p class="mb-0"><strong>Education</strong><br />
                      {% for item in ematrix.AttributeMatrixItems %}
                      {{ item | Attribute:'Education' }}<br>
                      {% endfor %}
                    </p>
                    {% endif %}
                    {% assign about = personObj | Attribute:'About' %}
                    {% if about != '' and about != null %}
                    <strong>About</strong>
                    <p>{{ personObj | Attribute:'About' }}</p>
                    {% endif %}
                  </div>
                  <div class="modal-footer">
                    <div class="ml-auto">
                      <button type="button"
                        class="twms__button twms__button-outline-dark-blue custom-button-width-modal-close"
                        data-dismiss="modal">Close</button>
                    </div>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% endcapture %}
          {% assign leadership_members = leadership_members | append: card_html | append: '||' %}

          {% endif %}
          {% endfor %}
          {% if leadership_members %}
          <h2 class="twms__subheader-blue mb-4 mt-4">LEADERSHIP</h2>
          <div class="twms-staff__flex-container-4col">
              {% assign cards_array = leadership_members | Split: '||' %}
              {% assign reversed_cards = cards_array | Reverse %}
              {% for card in reversed_cards %}
                  {{ card }}
              {% endfor %}
          </div>
          {% endif %}
          {% if admin_members %}
          <h2 class="twms__subheader-blue mb-4 mt-4">ADMIN</h2>
          <div class="twms-staff__flex-container-4col">
            {{ admin_members }}
          </div>
          {% endif %}
          {% if faculty_members %}
          <h2 class="twms__subheader-blue mb-4 mt-4">FACULTY</h2>
          <div class="twms-staff__flex-container-4col">
            {{ faculty_members }}
          </div>
          {% endif %}

        </div>
      </div>
    </div>
  </section>
