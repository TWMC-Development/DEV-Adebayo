<%@ Master Language="C#" AutoEventWireup="true" Inherits="Rock.Web.UI.RockMasterPage" %>
<%@ Import Namespace="System.Web.Optimization" %>
<!DOCTYPE html>

<script runat="server">

    // keep code below to call base class init method
    /// <summary>
    /// Raises the <see cref="E:System.Web.UI.Control.Init" /> event.
    /// </summary>
    /// <param name="e">An <see cref="T:System.EventArgs" /> object that contains the event data.</param>
    protected override void OnInit( EventArgs e )
    {
        base.OnInit( e );
    }

</script>

<html>
<head runat="server">

    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=no">
    <title></title>

    <!-- jQuery (required by Rock RMS) -->
    <script src="<%# System.Web.Optimization.Scripts.Url("~/Scripts/Bundles/RockJQueryLatest" ) %>"></script>

    <!-- Google Fonts: Playfair Display + DM Sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;0,600;0,700;0,800;1,400;1,500;1,600&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&display=swap" rel="stylesheet">

    <!-- Font Awesome 6 -->
    <script src="https://kit.fontawesome.com/85947205a9.js" crossorigin="anonymous"></script>

    <!-- Bootstrap 5.3 -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <!-- TWMC 2026 Design System -->
    <link rel="stylesheet" href="<%# ResolveRockUrl("~~/Styles/theme.css", true) %>">

    <!-- Rock RMS BS3 Compatibility Layer -->
    <link rel="stylesheet" href="<%# ResolveRockUrl("~~/Styles/rock-compat.css", true) %>">

    <!-- Rock Content Placeholders -->
    <asp:ContentPlaceHolder ID="css" runat="server"></asp:ContentPlaceHolder>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>

</head>

<body runat="server" id="body" class="content-body">

    <form id="form1" runat="server">

        <!-- Skip Link -->
        <a class="skip-link" href="#main-content">Skip to content</a>

        <!-- Location Bar -->
        <div class="location-bar">
            <Rock:Zone Name="LocationBar" runat="server" />
        </div>

        <!-- Navbar -->
        <header class="navbar navbar-expand-xl py-0 navbar-twmc" id="navbar">
            <div class="container-xxl px-4">
                <Rock:Zone Name="Navbar" runat="server" />
            </div>
        </header>

        <!-- Mobile Nav (Bootstrap Offcanvas) -->
        <Rock:Zone Name="MobileNav" runat="server" />

        <!-- Mega Menu -->
        <div class="mega-overlay" id="megaOverlay"></div>
        <div class="mega-panel" id="megaPanel">
            <Rock:Zone Name="MegaMenu" runat="server" />
        </div>

        <!-- Preloader -->
        <div class="header-preloader">
            <Rock:Zone Name="Preloader" runat="server" />
        </div>

        <!-- CTA Banner -->
        <div class="header-cta">
            <Rock:Zone Name="CTA" runat="server" />
        </div>

        <!-- Main Content -->
        <main id="main-content">
            <asp:ContentPlaceHolder ID="main" runat="server"></asp:ContentPlaceHolder>
        </main>

        <!-- GROW Section -->
        <Rock:Zone Name="GrowPathway" runat="server" />

        <!-- Footer -->
        <footer class="site-footer">
            <Rock:Zone Name="Footer" runat="server" />
        </footer>

        <!-- Scripts Zone -->
        <div class="footer-scripts">
            <Rock:Zone Name="Scripts" runat="server" />
        </div>

        <%-- Rock RMS ScriptManager and UpdateProgress --%>
        <asp:ScriptManager ID="sManager" runat="server"/>
        <asp:UpdateProgress id="updateProgress" runat="server" DisplayAfter="800">
            <ProgressTemplate>
                <div class="updateprogress-status">
                    <div class="spinner">
                        <div class="rect1"></div><div class="rect2"></div><div class="rect3"></div><div class="rect4"></div><div class="rect5"></div>
                    </div>
                </div>
                <div class="updateprogress-bg modal-backdrop"></div>
            </ProgressTemplate>
        </asp:UpdateProgress>

    </form>

    <!-- Bootstrap 5.3 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <!-- TWMC 2026 Theme JS -->
    <script src="<%# ResolveRockUrl("~~/Scripts/theme.js", true) %>"></script>

</body>
</html>
